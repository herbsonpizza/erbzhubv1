local function updateTheme()
	mainFrame.BackgroundColor3 = theme.BackgroundColor
	injectButton.BackgroundColor3 = theme.ButtonColor
	antiVoidSwitch.BackgroundColor3 = theme.ButtonColor
	injectButton.TextColor3 = theme.TextColor
	antiVoidSwitch.TextColor3 = theme.TextColor
	titleLabel.TextColor3 = theme.TextColor

	confirmFrame.BackgroundColor3 = theme.ConfirmBackground
	confirmLabel.TextColor3 = theme.TextColor
	yesButton.BackgroundColor3 = theme.YesColor
	noButton.BackgroundColor3 = theme.NoColor

	dropdownTitle.TextColor3 = theme.TextColor
end

-- Theme Buttons
local i = 0
for themeName, _ in pairs(themes) do
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 30)
	btn.Position = UDim2.new(0, 0, 0, 30 + i * 30)
	btn.Text = themeName
	btn.BackgroundColor3 = theme.ButtonColor
	btn.TextColor3 = theme.TextColor
	btn.Font = Enum.Font.SourceSans
	btn.TextSize = 18
	btn.Parent = themeDropdown
	roundify(btn, 4)
	btn.MouseButton1Click:Connect(function()
		currentThemeName = themeName
		theme = themes[themeName]
		updateTheme()
		themeDropdown.Visible = false
	end)
	i += 1
end

-- Toggle Dropdown with T
UserInputService.InputBegan:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.T then
		themeDropdown.Visible = not themeDropdown.Visible
	end
end)

