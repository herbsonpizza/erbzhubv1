-- Minimize / Maximize logic
local minimized = false
local minimizedSize = UDim2.new(0, 50, 0, 30)
local normalSize = UDim2.new(0, 400, 0, 220)

local elementsToToggle = {
    injectButton,
    antiVoidSwitch,
    titleLabel,
    themeDropdown,
    dropdownList
}

local function minimizeUI()
    minimized = true
    for _, element in ipairs(elementsToToggle) do
        element.Visible = false
    end
    TweenService:Create(mainFrame, TweenInfo.new(0.25), {Size = minimizedSize}):Play()
end

local function maximizeUI()
    minimized = false
    for _, element in ipairs(elementsToToggle) do
        element.Visible = true
    end
    TweenService:Create(mainFrame, TweenInfo.new(0.25), {Size = normalSize}):Play()
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.LeftControl then
        if minimized then
            maximizeUI()
        else
            minimizeUI()
        end
    end
end)

-- Initial Theme Setup
updateTheme()
