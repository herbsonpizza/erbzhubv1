themeDropdown.Parent = screenGui

local dropdownTitle = Instance.new("TextLabel")
dropdownTitle.Size = UDim2.new(1, 0, 0, 30)
dropdownTitle.Position = UDim2.new(0, 0, 0, 0)
dropdownTitle.Text = "Select Theme"
dropdownTitle.TextColor3 = theme.TextColor
dropdownTitle.BackgroundTransparency = 1
dropdownTitle.Font = Enum.Font.SourceSans
dropdownTitle.TextSize = 20
dropdownTitle.Parent = themeDropdown

local buttonHeight = 0.2
local buttons = {}

local function createDropdownButton(themeName, position)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, buttonHeight * 30)
    button.Position = UDim2.new(0, 0, 0, position)
    button.Text = themeName
    button.BackgroundColor3 = theme.ButtonColor
    button.TextColor3 = theme.TextColor
    button.Font = Enum.Font.SourceSans
    button.TextSize = 18
    button.Parent = themeDropdown
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = theme.ButtonHover}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = theme.ButtonColor}):Play()
    end)

    button.MouseButton1Click:Connect(function()
        currentThemeName = themeName
        theme = themes[themeName]
        updateTheme()
        themeDropdown.Visible = false
    end)
end

local i = 0
for themeName, _ in pairs(themes) do
    createDropdownButton(themeName, i * (buttonHeight * 30))
    i = i + 1
end

-- === Update Theme ===
local function updateTheme()
    mainFrame.BackgroundColor3 = theme.BackgroundColor
    injectButton.BackgroundColor3 = theme.ButtonColor
    antiVoidSwitch.BackgroundColor3 = theme.ButtonColor
    injectButton.TextColor3 = theme.TextColor
    antiVoidSwitch.TextColor3 = theme.TextColor
    titleLabel.TextColor3 = theme.TextColor
end

-- === AntiVoid Platform ===
local antiVoidEnabled = false
local antiVoidPlatform = nil
local platformHeight = -0.5  -- Set to Y = -0.5

local function createAntiVoidPlatform()
    antiVoidPlatform = Instance.new("Part")
    antiVoidPlatform.Size = Vector3.new(1000, 1, 1000)  -- Massive size
    antiVoidPlatform.Position = Vector3.new(0, platformHeight, 0)  -- Position at Y = -0.5
    antiVoidPlatform.Anchored = true
    antiVoidPlatform.CanCollide = true  -- Make it collidable so players can walk on it
    antiVoidPlatform.Transparency = 1  -- Completely invisible
    antiVoidPlatform.Parent = workspace
end

local function removeAntiVoidPlatform()
    if antiVoidPlatform then
        antiVoidPlatform:Destroy()
        antiVoidPlatform = nil
    end
end

antiVoidSwitch.MouseButton1Click:Connect(function()
    antiVoidEnabled = not antiVoidEnabled
    if antiVoidEnabled then
        antiVoidSwitch.Text = "AntiVoid: ON"
        createAntiVoidPlatform()
    else
        antiVoidSwitch.Text = "AntiVoid: OFF"
        removeAntiVoidPlatform()
    end
end)

